<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonLoaded">
  <ribbon>
    <tabs>
      <tab idMso="TabHome">
        <group id="sqGroup" label="Schnellbausteine">
          <menu id="sqMain" label="Schnellbausteine" imageMso="QuickPartsInsertGallery" size="large" itemSize="normal">
            <gallery id="sqGallery" label="Schnellbausteine" columns="1"
                     itemWidth="240" itemHeight="24" showLabel="false"
                     showItemLabel="true" showItemImage="false"
                     getItemCount="GetSnippetCount" getItemLabel="GetSnippetLabel"
                     getItemID="GetSnippetId" getEnabled="GetSnippetGalleryEnabled"
                     onAction="InsertGallerySnippet"/>
            <menuSeparator id="sqManageSeparator"/>
            <button id="sqManage" label="Schnellbausteine verwalten" onAction="ManageSnippets"/>
          </menu>
        </group>
      </tab>
    </tabs>
  </ribbon>
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <button id="sqSaveSelection" label="Als Schnellbaustein speichern..." imageMso="SaveSelectionToQuickPartGallery" onAction="SaveSelection" insertBeforeMso="Cut"/>
    </contextMenu>
  </contextMenus>
</customUI>
