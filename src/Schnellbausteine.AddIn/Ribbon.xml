<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonLoaded">
  <ribbon>
    <tabs>
      <tab idMso="TabInsert">
        <group id="sqGroup" label="OneNote Schnellbausteine">
          <dynamicMenu id="sqMain" label="OneNote Schnellbausteine" imageMso="QuickPartsInsertGallery"
                       size="large" getContent="GetSnippetMenuContent"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <dynamicMenu id="sqInsertText" label="OneNote Schnellbausteine" imageMso="QuickPartsInsertGallery"
                   getContent="GetSnippetMenuContent" insertBeforeMso="Cut"/>
      <menuSeparator id="sqContextSeparatorText" insertBeforeMso="Cut"/>
      <button id="sqSaveSelectionText" label="Als Schnellbaustein speichern..." imageMso="SaveSelectionToQuickPartGallery"
              onAction="SaveSelection" insertBeforeMso="Cut"/>
    </contextMenu>
    <contextMenu idMso="ContextMenuOutlineElementHandle">
      <dynamicMenu id="sqInsertOutline" label="OneNote Schnellbausteine" imageMso="QuickPartsInsertGallery"
                   getContent="GetSnippetMenuContent"/>
      <menuSeparator id="sqContextSeparatorOutline"/>
      <button id="sqSaveSelectionOutline" label="Als Schnellbaustein speichern..." imageMso="SaveSelectionToQuickPartGallery"
              onAction="SaveSelection"/>
    </contextMenu>
    <contextMenu idMso="ContextMenuInkDrawing">
      <dynamicMenu id="sqInsertInk" label="OneNote Schnellbausteine" imageMso="QuickPartsInsertGallery"
                   getContent="GetSnippetMenuContent"/>
      <menuSeparator id="sqContextSeparatorInk"/>
      <button id="sqSaveSelectionInk" label="Als Schnellbaustein speichern..." imageMso="SaveSelectionToQuickPartGallery"
              onAction="SaveSelection"/>
    </contextMenu>
    <contextMenu idMso="ContextMenuLassoSelection">
      <dynamicMenu id="sqInsertLasso" label="OneNote Schnellbausteine" imageMso="QuickPartsInsertGallery"
                   getContent="GetSnippetMenuContent"/>
      <menuSeparator id="sqContextSeparatorLasso"/>
      <button id="sqSaveSelectionLasso" label="Als Schnellbaustein speichern..." imageMso="SaveSelectionToQuickPartGallery"
              onAction="SaveSelection"/>
    </contextMenu>
  </contextMenus>
</customUI>
