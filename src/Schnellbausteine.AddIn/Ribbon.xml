<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonLoaded">
  <ribbon>
    <tabs>
      <tab idMso="TabHome">
        <group id="sqGroup" label="Schnellbausteine">
          <dynamicMenu id="sqInsertMenu" label="Einfügen" imageMso="QuickPartsInsertGallery" getContent="GetSnippetMenuContent" size="large"/>
          <button id="sqManage" label="Verwalten..." imageMso="Organizer" onAction="ManageSnippets"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <button id="sqSaveSelection" label="Als Schnellbaustein speichern..." imageMso="QuickPartsSaveSelectionToQuickPartGallery" onAction="SaveSelection" getVisible="CanSaveSelection"/>
    </contextMenu>
  </contextMenus>
</customUI>
